# Copy to .streamlit/secrets.toml on the server (never commit real keys).
# Streamlit Cloud: paste these in the app Secrets UI instead.

OPENAI_API_KEY = "your-key-here"
OPENAI_BASE_URL = "https://genai.hkbu.edu.hk/api/v1"
OPENAI_MODEL = "deepSeek-V4-Pro-hkbu"
OPENAI_VISION_MODEL = "gemini-3.8-flash"
LLM_PROVIDER = "hkbu"
# Stable cookie/auth signing across restarts (any long random string)
HKBU_SESSION_SECRET = "change-me-to-a-long-random-string"
